{
  "name": "littlewooly-sync",
  "version": "0.3.0",
  "description": "Real-time, end-to-end encrypted backup of ALL files in an Obsidian vault to any S3-compatible bucket. Provable coverage, no silent caps.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:minio:up": "bash test/shell/minio-start.sh",
    "test:minio:down": "bash test/shell/minio-stop.sh",
    "gates": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run verify:bundle",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "sync", "backup", "s3", "encryption", "e2ee"],
  "author": "Little Wooly",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.808.0",
    "@smithy/core": "^3.24.6",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "obsidian": "^1.11.4",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
